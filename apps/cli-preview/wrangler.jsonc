{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Name is overridden per-PR in CI: guilloteam-cli-preview-<pr-number>
	"name": "guilloteam-cli-preview",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": ["nodejs_compat"],

	"containers": [
		{
			"class_name": "CliPreviewTerminal",
			"image": "./Dockerfile",
			"instance_type": "basic",
			"max_instances": 1
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "CLI_PREVIEW",
				"class_name": "CliPreviewTerminal"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CliPreviewTerminal"]
		}
	],

	"vars": {
		// Overridden per-PR in CI via --var flag
		"PREVIEW_API_URL": "https://dev.api.guillo.team"
	},

	"observability": {
		"enabled": true
	}
}
