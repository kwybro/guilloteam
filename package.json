{
	"name": "guilloteam",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"check-types": "turbo run check-types",
		"guilloteam": "bun run apps/cli/src/index.ts",
		"mcp": "bun run apps/mcp/src/index.ts",
		"service": "bun run apps/service/src/index.ts",
		"service:up": "docker compose up --build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "^1.4.0",
		"turbo": "^2.10.12",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.8",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"zod": "^4.5.1"
	}
}
